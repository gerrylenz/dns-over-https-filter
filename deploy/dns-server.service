[Unit]
Description=DNS-over-HTTPS Filter
After=network-online.target unbound.service
Wants=network-online.target unbound.service

[Service]
User=dns-server
Group=dns-server
ExecStart=/usr/local/bin/dns-server --config /var/lib/dns-server/server.toml
WorkingDirectory=/var/lib/dns-server
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
